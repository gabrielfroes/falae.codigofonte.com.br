# URL pública da aplicação — usada para montar o redirect URI do OAuth
# e a URL do webhook que você cadastra no app da Meta. Veja docs/setup-meta.md.
APP_URL=https://falae.codigofonte.com.br

# Postgres
DATABASE_URL=postgresql://falae:falae@postgres:5432/falae

# Redis (BullMQ)
REDIS_URL=redis://redis:6379

# Chave usada para criptografar tokens de acesso em repouso (AES-256-GCM).
# Gere com: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Segredo para assinar sessões/cookies do painel.
# Gere com: openssl rand -hex 32
AUTH_SECRET=

# App da Meta (developers.facebook.com) — ver docs/setup-meta.md
META_APP_ID=
META_APP_SECRET=
# Token arbitrário que você escolhe e cadastra igual nos dois lados
# (aqui e no campo "Verify token" do webhook no painel da Meta).
META_WEBHOOK_VERIFY_TOKEN=
